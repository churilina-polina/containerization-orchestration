# ===== Стадия 1: builder – только установка зависимостей =====
# 1. Базовый образ для сборки
FROM python:3.11-slim AS builder

# 2. Рабочая директория стадии сборки
WORKDIR /app

# 3. Сначала только requirements.txt: слой с зависимостями кэшируется
#    и не пересобирается, когда меняется код приложения
COPY requirements.txt .

# 4. Ставим зависимости в отдельную папку /install
#    --no-cache-dir – pip не сохраняет кэш скачанных пакетов в образ
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# ===== Стадия 2: финальный образ – только то, что нужно для работы =====
# 5. Чистый базовый образ (всё лишнее из builder сюда не попадёт)
FROM python:3.11-slim

# 6. Метаданные
LABEL maintainer="churilina@lab.local"
LABEL version="3.0"

# 7. Python не создаёт файлы .pyc и сразу выводит логи
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# 8. Устанавливаем curl – он нужен для HEALTHCHECK (в slim-образе его нет);
#    --no-install-recommends – без лишних пакетов, затем чистим списки apt
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# 9. Рабочая директория
WORKDIR /app

# 10. Переносим из builder только установленные пакеты
COPY --from=builder /install /usr/local

# 11. Копируем код приложения
COPY app/ ./app/

# 12. Порт приложения
EXPOSE 5465

# 13. Проверка здоровья: каждые 30 с запрос к /health,
#     ждать ответа 5 с, первые 10 с – прогрев, 3 неудачи подряд = unhealthy
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:5465/health || exit 1

# 14. Запуск приложения на моём порту
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "5465"]
